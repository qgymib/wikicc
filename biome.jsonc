{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["src/web/css/**", "src/web/js/**", "tests/js/**", "tools/**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        // The codebase deliberately writes `function () {}` expressions; a
        // mechanical arrow rewrite would be a style migration, not a fix.
        "useArrowFunction": "off",
        // Existing style chains `a && a.b.c` guards; the rewrite churns 40
        // expressions without changing observable behaviour.
        "useOptionalChain": "off",
        // `!important` is deliberate in CSS: the reduced-motion reset must
        // beat every animation, and viewer rules must beat inline SVG
        // `max-width` styles injected by KaTeX and mermaid.
        "noImportantStyles": "off"
      },
      "correctness": {
        // Block-scoped function declarations inside branches are legal in
        // modules and part of the established style; modules never run in
        // sloppy mode, where this rule's bug class lives.
        "noInnerDeclarations": "off"
      },
      "nursery": {
        // A floating promise is how a test body's failed assertion became a
        // rejection the bridge's `--test-force-exit` exits before reporting:
        // an async harness the callers did not await swallowed the failure
        // and the test passed. The rule is the static guard for that class.
        // The reader's deliberate fire-and-forget calls — the diagram passes
        // that swallow their own failures — are marked `void`.
        "noFloatingPromises": "error"
      },
      "suspicious": {
        // `height: 100vh` followed by `height: 100dvh` is a deliberate
        // fallback cascade for browsers without dynamic viewport units.
        "noDuplicateProperties": "off"
      },
      "style": {
        // `a + " " + b` concatenation is the established style.
        "useTemplate": "off",
        // Component base styles intentionally follow their scoped
        // overrides (`.popover:not(...) .part` hides, then `.part` styles);
        // reordering selectors would flip the cascade.
        "noDescendingSpecificity": "off"
      }
    }
  },
  "assist": {
    "enabled": false
  }
}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark light">
<meta name="generator" content="wikicc">
<title>{{ title }}</title>
<style>
{{ css|safe }}
</style>
</head>
<body>
<a class="skip-link" href="#doc-content">Skip to content</a>
<noscript><p class="noscript">This reader needs JavaScript to display the documents.</p></noscript>
<div class="app" id="app">
  <header class="topbar">
    <button class="icon-button" id="sidebar-toggle" type="button" aria-label="Toggle document list" aria-expanded="false" aria-controls="sidebar">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <span class="topbar-title">{{ title }}</span>
  </header>
  <aside class="sidebar" id="sidebar" aria-label="Document navigation">
    <header class="sidebar-header">
      <p class="site-title" title="{{ title }}">{{ title }}</p>
      <button class="icon-button" id="theme-toggle" type="button" aria-label="Switch colour theme" aria-pressed="false" title="Switch colour theme">
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
      </button>
    </header>
    <div class="search-box">
      <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M16.5 16.5 21 21"/></svg>
      <input class="search-input" id="doc-filter" type="search" placeholder="Search documents" aria-label="Search documents" autocomplete="off" spellcheck="false">
    </div>
    <nav class="doc-list" id="doc-list" aria-label="Documents"></nav>
    <footer class="sidebar-footer" id="stats"></footer>
  </aside>
  <main class="content" id="doc-content" tabindex="-1"></main>
  <aside class="inspector" id="inspector" data-panel="toc" aria-label="Graph and outline">
    <div class="inspector-tabs" id="inspector-tabs" role="tablist" aria-label="Inspector panels">
      <button class="inspector-tab" type="button" role="tab" data-panel="graph" aria-selected="false" aria-controls="graph-panel">Graph</button>
      <button class="inspector-tab" type="button" role="tab" data-panel="toc" aria-selected="true" aria-controls="toc-panel">Outline</button>
    </div>
    <section class="panel graph-panel" id="graph-panel" aria-labelledby="graph-heading">
      <div class="panel-header">
        <h2 class="panel-heading" id="graph-heading">Graph</h2>
        <button class="panel-action" id="graph-fit" type="button" title="Fit graph to view" aria-label="Fit graph to view">Fit</button>
      </div>
      <div class="graph" id="graph"></div>
    </section>
    <section class="panel toc-panel" id="toc-panel" aria-labelledby="toc-heading">
      <h2 class="panel-heading" id="toc-heading">Outline</h2>
      <nav class="toc" id="toc" aria-label="Chapter outline"></nav>
    </section>
  </aside>
  <div class="drawer-backdrop" id="drawer-backdrop" hidden></div>
</div>
<script id="wikicc-payload" type="application/json">{{ payload|safe }}</script>
<script>
{{ js|safe }}
</script>
</body>
</html>

{
  "name": "wikicc-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "Third-party front-end libraries and the bundler used by the wikicc reader",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "check": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "lint": "biome lint ."
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "d3-drag": "3.0.0",
    "d3-force": "3.0.0",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "katex": "0.18.11",
    "mermaid": "12.2.0",
    "minisearch": "7.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "esbuild": "0.28.2"
  }
}

{
  "name": "wikicc-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "Third-party front-end libraries and the bundler used by the wikicc reader",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "check": "biome check --error-on-warnings . && djlint src/web/index.html.tmpl --lint --check",
    "format": "biome format --write . && djlint src/web/index.html.tmpl --reformat",
    "lint": "biome lint . && djlint src/web/index.html.tmpl --lint"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@panzoom/panzoom": "4.6.2",
    "d3-drag": "3.0.1",
    "d3-force": "3.0.1",
    "d3-selection": "3.0.1",
    "d3-zoom": "3.0.1",
    "katex": "0.19.1",
    "mermaid": "12.3.0",
    "minisearch": "7.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "djlint": "1.54.0",
    "esbuild": "0.28.2"
  }
}
